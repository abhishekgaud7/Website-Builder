# Database (Supabase PostgreSQL Connection Strings)
# Use the connection string from Supabase -> Settings -> Database -> Connection string (NodeJS or URI)
# Remember to change password placeholder to your actual database password!
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Google Gemini API Key (Get a free key from Google AI Studio at: https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase Frontend Credentials (Get these from Supabase -> Settings -> API)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
